<?xml version="1.0" encoding="utf-8"?>
<!-- The Fire TV / Android TV home-row banner (320 x 180). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0E131B" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:gravity="center" android:width="120dp" android:height="120dp" android:drawable="@drawable/banner_icon" />
</layer-list>
