{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProDeck",
  "version": "0.9.66",
  "identifier": "com.prodeck.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ProDeck",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://example.com/UPDATE-FEED/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxQTE4ODFFNUFBMjE2OEEKUldTS0ZxSmFIb2loSWMvcjMrSWZOdUVBdjNrV2QrR2lKVmY1NVB3RDdFZkJCb1BvTFhjVGg2SGgK"
    }
  }
}
