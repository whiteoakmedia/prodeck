<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Keeps ProDeck running: launchd relaunches it within ~10s of any crash
       (SuccessfulExit=false relaunches only non-zero exits, so a deliberate
       Cmd-Q stays quit). To restart on purpose:
         launchctl kickstart -k gui/$(id -u)/com.prodeck.watchdog -->
  <key>Label</key><string>com.prodeck.watchdog</string>
  <key>ProgramArguments</key>
  <array><string>/Applications/ProDeck.app/Contents/MacOS/prodeck</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
</dict>
</plist>
