{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Every church's crew address, <name>-crew.prodeck.live: the cloud copy of
  // the week for when the booth is off, and a relay to the booth when it's on.
  // See src/index.ts and design/CREW_ADDRESS.md.
  //
  // One level under prodeck.live on purpose: Cloudflare's free Universal SSL
  // certificate (*.prodeck.live) covers it, so no Advanced Certificate Manager.
  //
  // Not deployed yet. Before the first deploy (Zach, once):
  //  - Deploy prodeck-local (local-edge/) first: it exports the `Names`
  //    entrypoint this binds to, and writes each church's proxied DNS record
  //    (<name>-crew AAAA 100::) when its booth turns the crew address on.
  //  - Then uncomment "routes" below and deploy this. The pattern only matches
  //    hosts ending in "-crew.prodeck.live": never prodeck.live itself (crew-edge,
  //    prodeck.live/*), www, or anything under local.prodeck.live.
  //  - Last, set CREW_READY to "1" in local-edge/wrangler.jsonc and redeploy it:
  //    booths do nothing at all for the crew address until then.
  "name": "prodeck-crew",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // On: booths reach this Worker at prodeck-crew.taplink-edge.workers.dev,
  // naming their church in a header, so a booth never looks up its own new
  // <name>-crew.prodeck.live (a lookup made before the record reached the
  // internet gets "no such name" cached for up to half an hour). Phones can't
  // use it: a page there names no church and gets the "not a crew address" 404.
  "workers_dev": true,
  "routes": [{ "pattern": "*-crew.prodeck.live/*", "zone_name": "prodeck.live" }],
  "durable_objects": {
    "bindings": [
      { "name": "CHURCH", "class_name": "Church" },
      // The Next Slide leaderboard across every church (src/board.ts).
      { "name": "BOARD", "class_name": "Leaderboard" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Church"] },
    { "tag": "v2", "new_sqlite_classes": ["Leaderboard"] }
  ],
  "services": [{ "binding": "NAMES", "service": "prodeck-local", "entrypoint": "Names" }],
  // The app's built dist/ (npx vite build at the repo root before deploying):
  // the shell phones get while the booth is off, and the hashed files phones
  // fetch either way. run_worker_first so a linked booth answers first.
  "assets": { "directory": "../dist", "binding": "ASSETS", "run_worker_first": true },
  // Off: phones put the crew password in the URL (?token= on the event
  // stream), and request logs keep URLs.
  "observability": { "enabled": false }
}
